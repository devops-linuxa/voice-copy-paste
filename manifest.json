{
  "manifest_version": 3,
  "name": "Voice Copy-Paste",
  "version": "1.0.2",
  "description": "Voice-to-text conversion",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voice Copy-Paste",
    "default_icon": {
      "128": "icons/mic-128.png"
    }
  },
  "icons": {
    "128": "icons/mic-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Start or stop voice-to-text conversion"
    }
  }
}