
{
  "manifest_version": 3,
  "name": "Speech to Text RU EN",
  "version": "1.1.1",
  "description": "Диктовка по горячей клавише",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Speech to Text"
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Начать или остановить диктовку"
    }
  }
}