
{
  "manifest_version": 3,
  "name": "Speech to Text RU EN",
  "version": "1.2.1",
  "description": "Диктовка по горячей клавише",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Speech to Text"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Начать или остановить диктовку"
    }
  }
}